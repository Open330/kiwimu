{
  "name": "@open330/kiwimu",
  "version": "1.2.0",
  "description": "Turn textbooks, PDFs, and web content into your own interlinked learning wiki powered by LLM",
  "type": "module",
  "bin": {
    "kiwimu": "./bin/kiwimu"
  },
  "files": [
    "bin/**/*",
    "src/**/*",
    "!src/**/*.test.ts",
    "personas/**/*",
    "assets/**/*",
    "docs/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "wiki",
    "learning",
    "study",
    "textbook",
    "pdf",
    "llm",
    "gemini",
    "knowledge-graph",
    "education",
    "bun"
  ],
  "author": "jiunbae",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open330/kiwimu.git"
  },
  "homepage": "https://github.com/Open330/kiwimu",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test --no-orphans",
    "test:redis": "bun run scripts/test-redis.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "d3": "^7.9.0",
    "gh-pages": "^6.3.0",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "mammoth": "^1.12.0",
    "marked": "^15.0.0",
    "mermaid": "^11.16.1",
    "pdf-parse": "1.1.1",
    "sanitize-html": "^2.17.6",
    "smol-toml": "^1.7.0",
    "turndown": "^7.2.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "picomatch": "2.3.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "openai": "^6.31.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "latest",
    "@types/pdf-parse": "^1.1.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.5",
    "typescript": "7.0.2"
  }
}
